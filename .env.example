# Copy to .env and fill in your own values:  cp .env.example .env
#
# IMPORTANT: do not quote values. This file is read both by python-decouple
# and by `docker --env-file`, and docker does NOT strip quotes -- it would
# pass KEY="value" through as the literal string "value", quotes included.
# That failure mode is silent and produces confusing auth errors.
#
#   correct:    AWS_ACCESS_KEY_ID=AKIAEXAMPLE
#   broken:     AWS_ACCESS_KEY_ID="AKIAEXAMPLE"

# Django's signing key: session cookies, password-reset tokens. Must be secret,
# and must differ between your development and production environments.
# Generate one with:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"
SECRET_KEY=generate-your-own-do-not-reuse-this

# Which settings module to load: jolof.settings.development or .production
DJANGO_SETTINGS_MODULE=jolof.settings.development

# Comma-separated hostnames the site is served on (required in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- AWS S3 -----------------------------------------------------------------
# Two buckets: one public for static files, one private for user uploads
# (served via signed URLs). The IAM user needs GetObject, PutObject,
# DeleteObject, and ListBucket on both, and nothing else.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_REGION_NAME=us-east-1
AWS_MEDIA_BUCKET_NAME=your-media-bucket
AWS_STATIC_BUCKET_NAME=your-static-bucket

# --- PostgreSQL -------------------------------------------------------------
# DB_HOST is the container name when running under Docker on a shared network,
# or localhost when running the app directly.
DB_NAME=jolof
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
